  "mandatory_invariants": [
    {
      "id": "future_append",
      "requirement": "Hold roster/static/count feed fixed. Append status events strictly after t, including other-station lifetime extensions. All predictor tensors, masks, graph inputs and prediction keys at t remain bitwise identical.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "status_prefix_equivalence",
      "requirement": "Full raw status plus cutoff t equals an in-memory physically truncated status prefix <=t. This is a STATUS test, not a claim of raw bike-trip replay.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "no_future_status_certificate",
      "requirement": "Trace every status contributing to station masks and network numerator/denominator; all event timestamps <=t.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "exact_12h_boundary",
      "requirement": "Both backward and forward elapsed intervals accept exactly 12h and reject 12h+1 microsecond; exercise equality at s,e,t and lag-13 regression.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "train_inference_parity",
      "requirement": "Same city/station/origin and bound metadata yield bitwise identical features, masks, ordering and dtypes through training and inference entry points.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "fit_cutoff_invariance",
      "requirement": "Appending status after C cannot change frozen training keys, fit-specific labels/masks, adaptation pools, HA sufficient statistics or lookups. Include denominator changes.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "target_predictor_separation",
      "requirement": "Later retrospective evaluation adjudication cannot change earlier predictors, prediction keys or fitted artifacts.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "final_label_firewall",
      "requirement": "Deny final evaluation label paths to development, fitting and predictor APIs; commit predictions before evaluator label access; no test opens final labels.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "zero_denominator",
      "requirement": "D=0 gives G=0 and unknown, never division by zero or vacuous observability.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "exact_50_percent",
      "requirement": "Exercise D=1,2,3,4,5: minimum N=1,1,2,2,3 respectively; one fewer fails; use integer 2*N>=D.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "three_value_states",
      "requirement": "Positive certified d -> (log1p(d),1), certified zero -> (0,1), unavailable -> (0,0). Positive count alone cannot override coverage.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "duplicate_missing_determinism",
      "requirement": "Set semantics for duplicate station/timestamp evidence, deterministic ordering, null/missing event failure, and irrelevant payload conflicts leave masks unchanged.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "dst_elapsed_utc",
      "requirement": "Lags 1..24 and 168 are exact elapsed UTC offsets across both DST transitions; calendar uses pinned city timezone rules.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "fixed_cohort",
      "requirement": "Exactly the bound 799 identities and node order persist under appended status, changed eligibility diagnostics and changing coverage.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "static_hash_binding",
      "requirement": "Reject mismatched identity/coordinate/capacity/city/timezone hashes, versions or node ordering.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "idealized_count_feed",
      "requirement": "Q=1 exactly when e<=a; unfinished hour rejected; no duration/time_end/8h delay is introduced into active availability.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "no_retrospective_y_reads",
      "requirement": "Schema/code/read-projection checks demonstrate active predictor construction reads no retrospective Y or target-mask fields and does not shift them.",
      "status": "REQUIRED_NOT_EXECUTED"
    },
    {
      "id": "sealed_training_keys",
      "requirement": "Refuse any neural or HA fit before its sorted training-key manifest and associated value/mask/origin-feature snapshots are sealed and hash-reconciled.",
      "status": "REQUIRED_NOT_EXECUTED"
    }
  ],
